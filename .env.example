# PostgreSQL
DATABASE_URL=postgres://routecard:routecard@localhost:5432/routecard
PGHOST=localhost
PGPORT=5432
PGDATABASE=routecard
PGUSER=routecard
PGPASSWORD=routecard

# 服务
PORT=3000
NODE_ENV=development
CARD_FILE_DIR=./data/generated
AUTO_MIGRATE=true

# 首次初始化管理员；生产环境务必修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 下载签名（生产环境必须使用至少32字节随机值）
DOWNLOAD_SECRET=dev-download-secret-change-me
